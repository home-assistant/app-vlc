#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Send vlc_telnet discovery information to Home Assistant
# ==============================================================================
declare ha_config

# Give VLC a moment to listen. It only starts once the PulseAudio socket is
# available, so do not wait for long: this blocks the s6-rc startup, and with
# it a container stop.
bashio::net.wait_for 4212 localhost 5
if ! (echo > /dev/tcp/localhost/4212) > /dev/null 2>&1; then
    bashio::log.warning "VLC is not listening yet, sending discovery anyway."
fi

# Prepare discovery payload
ha_config=$(\
    bashio::var.json \
        host "$(hostname)" \
        port "^4212" \
        password "$(cat /data/secret)" \
)

if bashio::discovery "vlc_telnet" "${ha_config}" > /dev/null; then
    bashio::log.info "Successfully send discovery information to Home Assistant."
else
    bashio::log.error "Discovery message to Home Assistant failed!"
fi
